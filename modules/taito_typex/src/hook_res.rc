/* hook_res.rc -- embeds this board's hook DLL into ultra_taito_typex.dll as
 * RCDATA, so exactly one file ships/gets signed for this board. UNFROZEN
 * 2026-09-27: this now points at the hook build_module.sh just built FROM
 * SOURCE (src/build_hook.sh), not the old frozen prebuilt/ copy -- see
 * build_module.sh's header for why that's safe (Chaos Breaker runs from its
 * own insulated .ufw container). Extracted back out at runtime by
 * find_hook() in taito_typex_main.c. See docs/PROJECT_LICENSING_AND_SIGNING.md.
 *
 * 32-bit only -- main.c never looks for a 64-bit variant.
 */
HOOK32 RCDATA "ultra_taito_typex_hook32.dll"

/* Separate, independently built/injected fix DLL -- deliberately NOT folded
 * into the frozen hook above (see codepage_spoof_standalone.c's header for
 * why). Only loaded, additionally, for a title whose provisional-fix entry
 * asks for it (taito_typex_main.c); every other title's injection is
 * unchanged. */
CPSPOOF32 RCDATA "ultra_typex_codepage_spoof32.dll"

/* Same rationale: Block King Ball Shooter's lsdrv.dll companion-service shim
 * (lsdrv_shim_standalone.c), kept out of the frozen hook. */
LSDRVSHIM32 RCDATA "ultra_typex_lsdrv_shim32.dll"

/* Same rationale: gamepad -> keyboard bridge for test-menu screens that read
 * the keyboard directly (keybridge_standalone.c), kept out of the frozen
 * hook -- Omni-Bridge itself postdates that freeze, see that file's header. */
KEYBRIDGE32 RCDATA "ultra_typex_keybridge32.dll"

/* Designs around the calibration screen instead of satisfying its real
 * touch-panel handshake (calib_bypass_standalone.c) -- calls the screen's
 * own existing close method directly once its real instance is identified. */
CALIBBYPASS32 RCDATA "ultra_typex_calib_bypass32.dll"
