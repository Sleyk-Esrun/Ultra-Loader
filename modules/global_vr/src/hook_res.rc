/* hook_res.rc -- embeds this board's own hook DLL(s) into ultra_global_vr.dll
 * as RCDATA, so exactly one file ships/gets signed for this board. Built by
 * build_module.sh AFTER build_gvr_hook.sh produces the hook binaries (which
 * land at the board root, not src/hook/ -- see that script). Extracted back
 * out at runtime by extract_hook_to_temp() in global_vr_main.c. See
 * docs/PROJECT_LICENSING_AND_SIGNING.md.
 */
HOOK32 RCDATA "../ultra_global_vr_hook32.dll"
HOOK64 RCDATA "../ultra_global_vr_hook64.dll"
